# FileEngine frontend — production build (unified docker stack).
#
# Behind the nginx reverse proxy the SPA and its APIs are same-origin, so the
# bridge and CSAI are reached via path prefixes rather than absolute hosts.
# nginx routes /api/ -> http-bridge and /csai/ -> csai-app on each tenant vhost.
VITE_API_BASE=/api
VITE_CSAI_BASE=/csai
# nginx also routes /discuss/ -> discussion and /ldapadmin/ -> ldap-manager.
# These were previously only set in the (gitignored) local .env, so a clean clone
# built the SPA against the dev localhost defaults.
VITE_DISCUSS_BASE=/discuss
VITE_LDAPADMIN_BASE=/ldapadmin

# OAuth login buttons (must be enabled on the bridge).
VITE_OAUTH_PROVIDERS=google,github

# Tenancy is keyed by the leading subdomain label of each tenant vhost
# (<tenant>.<base-domain> -> tenant "<tenant>"), regardless of the base domain,
# so no base-domain config is needed here.

VITE_FOLDER_ACTIONS_BASE=/folder-actions

# difference_service — version comparison (diff renditions)
VITE_DIFF_BASE=/diff

# File list background sync interval (ms). The browser silently re-pulls the
# current directory so out-of-band changes appear without a manual refresh;
# suspended while the tab is backgrounded / another view is showing. 0 disables.
VITE_FILE_LIST_POLL_MS=10000
